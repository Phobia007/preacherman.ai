{
  "name": "preacherman-ai-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "open": "node scripts/open-local.mjs",
    "test:launcher": "node --test scripts/tests/native-node.test.mjs scripts/tests/open-target.test.mjs",
    "local": "node scripts/local.mjs",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "preview": "node scripts/preview.mjs",
    "browser:setup": "npm --prefix browser run setup",
    "browser:build": "npm --prefix browser run build",
    "browser:preview": "npm --prefix browser run preview",
    "check": "npm run build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.134.0"
  }
}
